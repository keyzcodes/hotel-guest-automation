# Copy to container.env privately on the server; never commit that file.
# Docker Compose 2.30+ raw env_file: do NOT wrap values in quotes.
# Dollar signs in password hashes/URIs are kept literally.
APP_PUBLIC_URL=https://demo.example.com
FRONTEND_ORIGINS=https://demo.example.com
TRUST_PROXY=1
MONGO_URI=REPLACE_WITH_PRIVATE_ATLAS_URI
STAFF_EMAIL=REPLACE_WITH_STAFF_EMAIL
STAFF_PASSWORD_HASH=REPLACE_WITH_EXISTING_SCRYPT_HASH
STAFF_ACCOUNTS_ENABLED=false
SALES_EXPENSES_ENABLED=false
ROOM_BOARD_ENABLED=true
HOTEL_NAME=Kudu Demo
HOTEL_GUEST_NAME=Kudu Demo Hotel

# Deliberately disabled until the standalone server is verified.
GUEST_CHANNEL=WHATSAPP
GUEST_MESSAGING_ENABLED=false
WHATSAPP_STAY_MESSAGES_ENABLED=false
WHATSAPP_DEMO_GM_SUMMARY_ENABLED=false
WHATSAPP_BOOKING_WORKFLOW_ENABLED=false
WHATSAPP_AVAILABILITY_ENABLED=false
WHATSAPP_ENQUIRY_AGENT_ENABLED=false
JOB_DEMO_MODE=false
USE_MOCK_AI=false
WHATSAPP_PRE_STAY_TIMEOUT_MS=20000
# Enable WhatsApp only after copying the same session encryption key privately
# and stopping the old owner. Current code requires sesora_whatsapp_lab.
WHATSAPP_SESSION_MONGO_URI=REPLACE_WITH_PRIVATE_LAB_ATLAS_URI
WHATSAPP_SESSION_KEY=REPLACE_WITH_EXISTING_SESSION_KEY
GEMINI_API_KEY=REPLACE_WITH_PRIVATE_KEY
